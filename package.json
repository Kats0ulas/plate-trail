{
  "name": "plate-trail",
  "private": true,
  "version": "0.1.0",
  "description": "What would a license-plate camera network learn about your week, and how much does the data-retention period change that?",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "test": "vitest run",
    "test:coverage": "vitest run -c vitest.coverage.config.ts",
    "demo": "tsx scripts/make-demo.ts"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.3",
    "@turf/clusters-dbscan": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "flatbush": "^4.6.2",
    "maplibre-gl": "^6.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
