# Never commit real location history. GPS exports are ignored everywhere...
*.gpx
*.fit
*.tcx
*.kml
*.json
# ...except the synthetic demo data and the project's own config files.
!public/demo/**/*.gpx
!public/demo/**/*.json
!tests/fixtures/*.json
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.node.json
!.prettierrc.json
